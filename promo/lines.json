{
  "characters": {
    "nar": "三十岁左右的女性旁白，声音温暖、沉稳，有电影预告片的质感，语速稍慢，吐字清晰。",
    "boss": "中年男性领导，男中音，嗓音粗重，暴怒地训斥下属，语速快，音量大，很凶。",
    "woman": "二十多岁瘦弱的年轻女性，声音很轻，委屈又害怕，带着哭腔，有点发抖。",
    "juiz": "十几岁的可爱少女声，元气、温柔、清亮，像动画里贴心的小助手。"
  },
  "lines": [
    {
      "id": "nar_1",
      "who": "nar",
      "text": "每天，都有这样一通电话。",
      "emotion": "低沉，意味深长。"
    },
    {
      "id": "boss_1",
      "who": "boss",
      "text": "这点事都做不好？明天早上之前，给我重做！",
      "emotion": "咆哮，非常愤怒。"
    },
    {
      "id": "woman_1",
      "who": "woman",
      "text": "好的……好的，我马上改……",
      "emotion": "小声，快要哭出来。"
    },
    {
      "id": "nar_2",
      "who": "nar",
      "text": "而这样的人，不止你一个。",
      "emotion": "平静而心疼。"
    },
    {
      "id": "juiz_1",
      "who": "juiz",
      "text": "别怕，我来帮你！",
      "emotion": "明亮，坚定，带着笑意。"
    },
    {
      "id": "nar_3",
      "who": "nar",
      "text": "难听的话，Juiz 替你挡住。你只看要点。",
      "say": "难听的话，朱伊斯替你挡住。你只看要点。",
      "emotion": "温柔有力。"
    },
    {
      "id": "nar_3b",
      "who": "nar",
      "text": "想怎么回，你来挑；Juiz 替你说出口。",
      "say": "想怎么回，你来挑；朱伊斯替你说出口。",
      "emotion": "轻快，笃定。"
    },
    {
      "id": "juiz_2",
      "who": "juiz",
      "text": "您好，我是她的 AI 助理。文件已经发到您登记的邮箱了。",
      "emotion": "礼貌、专业、轻声。"
    },
    {
      "id": "nar_4",
      "who": "nar",
      "text": "深夜的电话，交给 Juiz。",
      "say": "深夜的电话，交给朱伊斯。",
      "emotion": "轻柔，像哄人入睡。"
    },
    {
      "id": "nar_5",
      "who": "nar",
      "text": "活交给大模型去做，你只需要最后，点一下批准。",
      "emotion": "轻快，自信。"
    },
    {
      "id": "nar_6",
      "who": "nar",
      "text": "从今天起，负面情绪，挡在门外。",
      "emotion": "明亮，充满希望。"
    },
    {
      "id": "nar_6b",
      "who": "nar",
      "text": "每一个像她一样的人，都值得被温柔以待。",
      "emotion": "温柔，真诚，带着笑意。"
    },
    {
      "id": "juiz_3",
      "who": "juiz",
      "text": "早上好！今天也一起加油吧！",
      "emotion": "元气满满，开心。"
    },
    {
      "id": "nar_7",
      "who": "nar",
      "text": "Juiz。你的私人助理。",
      "say": "朱伊斯。你的私人助理。",
      "emotion": "温暖，收尾。"
    }
  ]
}